DATABASE_URL=postgresql://nlsql_app:nlsql_app@localhost:5432/nlsql
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini

SCHEMA_CACHE_TTL_SECONDS=3600
MAX_CORRECTION_ATTEMPTS=3
MAX_RESULT_ROWS=200

# Demo mode: visitors can try the service against their own Postgres
# database for a single, unpersisted session (see README).
DEMO_SESSION_TTL_SECONDS=1800
MAX_DEMO_SESSIONS=20
# Only flip this on for local testing against a private/dev database.
ALLOW_PRIVATE_DEMO_HOSTS=false

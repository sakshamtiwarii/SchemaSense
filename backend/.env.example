DATABASE_URL=postgresql://nlsql_app:nlsql_app@localhost:5432/nlsql
REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
# Which OpenAI-compatible endpoint OPENAI_API_KEY above is actually for.
# Default "openai" behaves exactly as the name suggests. Set to "groq" to
# make a Groq key (and a Groq model in CHAT_MODEL, e.g.
# openai/gpt-oss-120b) the server's own default instead — same
# provider routing bring-your-own-key uses, just for the default path.
DEFAULT_LLM_PROVIDER=openai

SCHEMA_CACHE_TTL_SECONDS=3600
MAX_CORRECTION_ATTEMPTS=3
MAX_RESULT_ROWS=200

# Demo mode: visitors can try the service against their own Postgres
# database for a single, unpersisted session (see README).
DEMO_SESSION_TTL_SECONDS=1800
MAX_DEMO_SESSIONS=20
# Only flip this on for local testing against a private/dev database.
ALLOW_PRIVATE_DEMO_HOSTS=false

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the local Vite dev server. In production, set this to the
# real frontend origin(s) — never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per-client-IP request caps (Redis-backed, correct across replicas).
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_DEMO_CONNECT_PER_MINUTE=5
RATE_LIMIT_SCHEMA_PER_MINUTE=30
